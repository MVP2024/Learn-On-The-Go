# Публичный базовый URL проекта (для ссылок в письмах и webhook)
# Для локали: http://127.0.0.1:8000
# Для сервера: http://<SERVER_IP>
BASE_URL=<redacted>

# Хосты, которым разрешён доступ к Django (через запятую)
# Примеры:
#   локально: ALLOWED_HOSTS=127.0.0.1,localhost
#   сервер:   ALLOWED_HOSTS=158.160.xx.xx,localhost
ALLOWED_HOSTS=<redacted>

# Настройки Stripe (намного проще чем ЮKassa!)
STRIPE_PUBLISHABLE_KEY=<redacted>
STRIPE_SECRET_KEY=<redacted>
STRIPE_WEBHOOK_SECRET=<redacted>
STRIPE_TEST_MODE=<redacted>

# Настройки redis
